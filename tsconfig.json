{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "aws-lambda"]
  },
  "references": [
    { "path": "./apps/api" },
    { "path": "./apps/web" },
    { "path": "./infra" }
  ],
  "include": [
    "src/lambda.ts",
    "src/index.ts", 
    "src/middleware/*.ts",
    "src/routes/*.ts"
  ],
  "exclude": [
    "node_modules", 
    "dist",
    "src/schema/**/*",
    "src/prisma/**/*",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
} 
